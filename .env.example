COFFEE_POD_HOST=127.0.0.1
COFFEE_POD_PORT=8733
COFFEE_POD_DATA_DIR=./data
COFFEE_POD_ID=founder
COFFEE_POD_NAME=Founder Pod
COFFEE_POD_URL=http://127.0.0.1:8733

# Set this for VPS/cloud/staging use. Leave unset only for local throwaway dev.
COFFEE_POD_API_TOKEN=replace-me

# Optional. If omitted, Smartware creates an owner id on first boot.
COFFEE_POD_OWNER_ID=

# Google OAuth — shared across Drive, Calendar, Gmail
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
