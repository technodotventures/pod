{
  "name": "coffee-pod",
  "version": "0.1.0",
  "description": "Pod runtime: user-owned memory companion powered by Smartware.",
  "author": "Coffee",
  "type": "module",
  "main": "electron/main.cjs",
  "types": "dist/server.d.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:all": "node --env-file=.env scripts/dev-all.mjs",
    "mcp:dev": "tsx src/mcp-server.ts",
    "ui:dev": "npm run dev:all",
    "ui:only": "vite",
    "ui:build": "vite build",
    "ui:preview": "vite preview --host 127.0.0.1",
    "build": "tsc",
    "lint": "npm run typecheck",
    "build:all": "npm run build && npm run ui:build",
    "mcp": "node --env-file=.env dist/mcp-server.js",
    "desktop:dev": "npm run build:all && electron electron/main.cjs",
    "desktop:pack": "npm run build:all && node scripts/build-desktop.cjs dir",
    "desktop:dmg": "npm run build:all && node scripts/build-desktop.cjs dmg",
    "start": "node --env-file=.env dist/server.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "verify:smartware-release": "node scripts/smartware-release-check.mjs verify",
    "verify:smartware-vendor": "npm run verify:smartware-release",
    "check:smartware-upstream": "node scripts/smartware-release-check.mjs upstream",
    "test": "npm run clean && npm run build && node --test --test-force-exit $(find dist/test -name '*.test.js' -type f)",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "smoke:coffee": "node scripts/coffee-staging-smoke.mjs",
    "benchmark:smoke": "node scripts/benchmark-smoke.mjs",
    "benchmark:recall": "node scripts/run-benchmark-fixture.mjs benchmarks/recall/representative-v1.json",
    "benchmark:locomo": "node scripts/run-benchmark-fixture.mjs benchmarks/locomo/smoke.json",
    "benchmark:longmemeval": "node scripts/run-benchmark-fixture.mjs benchmarks/longmemeval/smoke.json",
    "beta:acceptance": "npm run build:all && node scripts/beta-acceptance.mjs",
    "beta:gate": "npm run typecheck && npm test && npm run ui:build && node scripts/beta-acceptance.mjs",
    "typecheck": "npm run typecheck:server && npm run typecheck:ui",
    "typecheck:server": "tsc --noEmit",
    "typecheck:ui": "tsc -p ui/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@technodotventures/smartware-connectors": "^0.1.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.10.0",
    "imapflow": "^1.4.7",
    "jszip": "^3.10.1",
    "mailparser": "^3.9.14",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "smartware": "^0.6.3",
    "tar": "^7.5.22",
    "yaml": "^2.8.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@udecode/plate": "^48.0.5",
    "@udecode/plate-autoformat": "^48.0.0",
    "@udecode/plate-basic-marks": "^48.0.0",
    "@udecode/plate-block-quote": "^48.0.0",
    "@udecode/plate-code-block": "^48.0.0",
    "@udecode/plate-floating": "^48.0.0",
    "@udecode/plate-heading": "^48.0.0",
    "@udecode/plate-horizontal-rule": "^48.0.0",
    "@udecode/plate-layout": "^48.0.0",
    "@udecode/plate-list": "^48.0.0",
    "@udecode/plate-markdown": "^48.0.2",
    "@udecode/plate-paragraph": "^36.0.0",
    "@udecode/plate-table": "^48.0.6",
    "@vitejs/plugin-react": "^6.0.1",
    "3d-force-graph": "^1.80.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-metrics": "^2.4.0",
    "graphology-shortest-path": "^2.1.0",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.185.1",
    "three-spritetext": "^1.10.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@fastify/swagger-ui": {
      "@fastify/static": "^10.1.2"
    },
    "@hono/node-server": "^2.0.11",
    "brace-expansion": "^5.0.8",
    "deepmerge-ts": "^8.0.0"
  },
  "build": {
    "appId": "ai.meetcoffee.pod",
    "productName": "Pod",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/@napi-rs/canvas-*/**/*"
    ],
    "files": [
      "dist/**/*",
      "dist-ui/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*",
      "!**/.env",
      "!**/.env.*",
      "!**/.DS_Store",
      "!**/.claude/**/*",
      "!**/.git/**/*",
      "!**/test/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "ui/public/brand/pod-icon-tile.png",
      "identity": null,
      "target": [
        "dir"
      ]
    },
    "electronVersion": "43.4.0",
    "npmRebuild": false
  }
}
